{
  "name": "dsh-retcon",
  "version": "0.2.2",
  "description": "写判断时检查「什么情况下它是错的」——没写就不许过。一份封存格式 + 一把尺子；DSH 插件是可选的自动手，不装也能照格式手写。",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "ai-memory",
    "long-term-memory",
    "falsifiable",
    "judgement",
    "audit-trail",
    "markdown-format",
    "retrospective"
  ],
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "格式.md",
    "CHANGELOG.md",
    "LICENSE",
    "读取/",
    "scripts/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
